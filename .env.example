# Copy to .env and edit. Never commit .env. Every setting is optional.

# SQLite file (default: study_planner.db in the project folder)
# DATABASE_URL=sqlite:///./study_planner.db

# How many days ahead to plan (1-28)
PLAN_HORIZON_DAYS=7

# --- Optional AI (any OpenAI-compatible API) ---
# Leave AI_MODEL empty to use the rule-based explanations and breakdowns only.
# OpenAI:  AI_MODEL=gpt-4o-mini  AI_API_KEY=<your key>  (AI_BASE_URL empty)
# Ollama:  AI_MODEL=llama3.2     AI_BASE_URL=http://127.0.0.1:11434/v1  (no key needed)
# Groq:    AI_MODEL=<model id>   AI_BASE_URL=https://api.groq.com/openai/v1  AI_API_KEY=<your key>
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
